/* *****************************************************************************
// Non-localised resources of the "Tapir Translator" add-on
//
//   ROLE IN THE SYSTEM
//   The add-on translates, live, the (tkinter) interface of the Python scripts
//   launched by the Tapir palette, without modifying the scripts: see README.md.
//   This file holds the resources that do not depend on the interface language:
//     - MDID: the add-on identifier (developer ID + local ID) required by ArchiCAD;
//     - STR# 32000: name and description shown in the Add-On Manager
//       (read by CheckEnvironment in Src/AddOnMain.cpp, which appends the version).
//
//   The menus (20 languages) are in Tapir_TranslatorMenus.grc, generated at build
//   time by Tools/GenerateMenus.cpp from Src/TT_Texts.cpp:
//     MenuBase (language) + 0 input language, + 1 output language, + 2 Options,
//     + 3 online translator, + 4 tool language; help strings at + 300
//     (resource IDs must stay below 32767: see TT_Texts.hpp).
// ****************************************************************************/


'MDID' 32500 "Add-On Identifier" {
	623201637		// Developer ID
	1856068953		// Local ID (Tapir Translator)
}


'STR#' 32000 "Add-on Name and Description" {
/* [  1] */		"Tapir Translator"
/* [  2] */		"Translates live the interface of the Python scripts launched by Tapir, without modifying the scripts"
}


